<!--
  Variant A (streaming): response buffering OFF so each backend chunk is relayed immediately.
  Per Learn (How to configure SSE): https://learn.microsoft.com/azure/api-management/how-to-server-sent-events
  Per Learn (forward-request): https://learn.microsoft.com/azure/api-management/forward-request-policy
  `timeout` is the wait for response HEADERS; Learn says values > 240 s may not be honoured. We set
  600 deliberately, so H1 tests what the platform does rather than what the policy asks for.
  Intentionally absent: validate-content, caching, and any request/response body logging.
-->
<policies>
  <inbound>
    <base />
    <set-header name="x-mock-key" exists-action="override">
      <value>{{mock-key}}</value>
    </set-header>
  </inbound>
  <backend>
    <forward-request timeout="600" buffer-response="false" fail-on-error-status-code="false" />
  </backend>
  <outbound>
    <base />
  </outbound>
  <on-error>
    <base />
  </on-error>
</policies>
