# Copy to .env (git-ignored). Never commit real values.
# Used for local runs and as the source for infra deployment parameters.

# --- Deployment target (placeholders; confirm before any deployment) ---
AZURE_SUBSCRIPTION_ID=<subscription-id>
AZURE_LOCATION=swedencentral
NAME_PREFIX=apimtlab
APIM_SKU=Developer            # Developer | StandardV2 (never Consumption)
APIM_PUBLISHER_EMAIL=<you@example.com>

# --- Shared secret between APIM/client and the mock (generate a random string) ---
MOCK_API_KEY=<random-string>

# --- Client: mock endpoints ---
MOCK_BASE_URL=http://<mock-fqdn>:8000
APIM_BASE_URL=https://<apim-name>.azure-api.net
APIM_SUBSCRIPTION_KEY=<apim-subscription-key>
APIM_STREAM_PATH=lab            # API path with buffer-response="false"
APIM_BUFFERED_PATH=lab-buffered # API path with buffer-response="true"

# --- Client: output ---
RESULTS_DIR=results

# --- Optional: real-model mode (OpenAI SDK against APIM or direct) ---
OPENAI_BASE_URL=
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_AUTH_HEADER=api-key      # header APIM expects, e.g. api-key or Ocp-Apim-Subscription-Key
OPENAI_PROMPT=Write a long, detailed essay about the history of timeouts.
