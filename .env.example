# Copy to .env (git-ignored). Placeholders only; never commit real values.
# Read by the deploy commands in README.md (infra/main.bicepparam) and by local runs.

# --- Deployment target ---
AZURE_SUBSCRIPTION_ID=<subscription-id>
AZURE_LOCATION=<region>
NAME_PREFIX=<short-prefix>          # 3-12 chars; resource group becomes rg-<prefix>
APIM_SKU=Developer                  # Developer | StandardV2 (never Consumption)
APIM_PUBLISHER_EMAIL=<you@example.com>

# --- Model (Microsoft Foundry) ---
MODEL_SKU=GlobalStandard            # GlobalStandard | DataZoneStandard
MODEL_CAPACITY=<k-tokens-per-minute>  # limited by your subscription quota

# --- AI Search (use another region if the primary one is out of capacity) ---
SEARCH_SKU=basic                    # free | basic
SEARCH_LOCATION=<region>

# --- Pipeline retry policy (HTTP-level and per agent run). PLACEHOLDER until the customer's real settings are
# known. The matrix always uses a single attempt. A 100K-token planner needs retries on a small TPM quota.
LLM_MAX_ATTEMPTS=4
LLM_RETRY_BACKOFF_S=20
LLM_TPM_BUDGET=<tokens-per-minute>   # slightly below the model quota (MODEL_CAPACITY x 1000); 0 = no pacing

# --- Secrets: generate random values (e.g. `openssl rand -hex 24`) ---
LAB_PASSWORD=<random>               # HTTP basic-auth password for the web UI (any user name)
INTERNAL_TOKEN=<random>             # worker -> api callbacks

# --- Set by deploy commands ---
IMAGE_TAG=latest
DEPLOY_APPS=false                   # true for phase 2, after the images are in ACR
